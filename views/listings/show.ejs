<% layout("/layouts/boilerplate") %>

<body>
    <div class = "container">
        <div class = "show-contact">
            <span class="card-show">
                <h4 class = "edit-form-header mt-4 mb-4"><%=listing.title%></h4>
                <img src="<%=listing.image.url%>" class="card-show-img-top" alt="listing-img">
                <div class="card-body">
                  <p class="card-text">
                    <%= listing.Description%> <br>
                    &#x20B9; <%= listing.price.toLocaleString("en-IN")%> / night <br>
                    <%= listing.location%> <br>
                    <%= listing.country%>
                  </p>
                </div>
                <% if(currUser && currUser._id.equals(listing.owner._id)){%>
                    <span class = "show-page-btn">
                        <form action="/listings/<%=listing._id%>/edit" method = "GET">
                            <button type="submit" class="btn btn-warning">Edit</button>
                        </form>
                        <form action="/listings/<%=listing._id%>?_method=delete" method = "POST">
                            <br>
                            <button type="submit" class="btn btn-danger">Delete</button>
                            <!-- <button type="submit" class="btn btn-outline-danger">Delete</button> -->
                        </form>
                    </span>
                <%}%>
            </span>
            <div class = "contact-show">
                <img src="/images/agent.avif" alt="agent-img">
                <h4><%= listing.owner.username %></h4>
                <div class = "agent-conect">
                    <a href="mailto:<%=listing.owner.email%>" class = "email-agent">
                        <i class="fa-regular fa-envelope"></i>
                    </a>
                    <a href="https://wa.me/<%=listing.owner.phone%>" class = "phone-agent">
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                </div>
            </div>
        </div>
        
        
        <hr>
        <% if(currUser){%>
        <div class = "review mb-3">
            <h4>Leave a Review</h4>
            <form action="/listings/<%=listing._id%>/reviews" method = "POST">
                <div class = "mb-0 mt-3">
                    <label for="rating" class = "form-label"><b style="opacity: 0.9;">Rating</b></label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                      </fieldset>
                </div>
                <div class = "mb-3 mt-0">
                    <label for="comment" class = "form-label"><b style="opacity: 0.9;">Comment</b></label>
                    <textarea class = "form-control" name="review[comment]" id="comment" rows="5" cols="30" placeholder="Enter your comment here..!" required></textarea>
                </div>
                <button class = "btn btn-outline-dark">Submit</button>
            </form>
        </div>
        <hr>
        <% } %>
        <%if(listing.reviews.length > 0){%>
            <h4>All Reviews</h4>
            <div class = "row">
                <%for(review of listing.reviews){%>
                    <div class = "reviewCard card col-5 ms-3 mb-3">
                        <div class="card-body">
                            <h5 class = "card-title">
                                <!-- <a href="https://wa.me/<%=review.author.phone%>" class = "review-connect"><%=review.author.username%></a> -->
                                <a href="mailto:<%=review.author.email%>" class = "review-connect"><%=review.author.username%></a>
                            </h5>
                            <p class="starability-result card-text" data-rating="<%=review.rating%>">
                            <p class = "card-text"><%=review.comment%></p>
                            <%if(currUser){%>
                                <form class = "mb-3" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST">
                                    <button class = "btn btn-sm btn-dark">Delete</button>
                                </form>
                            <%}%>
                        </div>
                    </div>
                <%}%>
            </div>
        <%}%>
    </div>
</body>
