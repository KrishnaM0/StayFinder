<% layout("/layouts/boilerplate") %>
<body>
    <br>
    <div class = "signup-container">
        <div class = "col-6 offset-3">
            <div class = "signup-page">
                <h3 style="text-align: center; text-decoration :overline red">Signup</h3>
                <hr>
                <form action="/signup" method = "POST" class = "needs-validation" novalidate>
                    <div class = "mb-3">
                        <label for="username" class = "form-label">Username</label>
                        <input name = "username" id = "username" class = "form-control" type="text" required>
                    </div>
                    <div class = "mb-3">
                        <label for="email" class = "form-label">Email</label>
                        <input name = "email" id = "email" class = "form-control" type="email" required>
                    </div>
                    <div class = "mb-3">
                        <label for="password" class = "form-label">Password</label>
                        <input name = "password" id = "password" class = "form-control" type="password" required>
                    </div>
                    <div class = "mb-3">
                        <label for="mobileNumber" class = "form-label">Mobile Number</label>
                        <input name = "phone" id = "mobileNumber" class = "form-control" type="number" required>
                    </div>
                    <button class = "btn btn-success signup-btn" style="margin-left: 0;">Sign up</button>
                </form>
            </div>
        </div>
    </div>
    <br><br><br>
</body>