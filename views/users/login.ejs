<% layout("/layouts/boilerplate") %>
<body>
    <div class = "signup-container">
        <div class = "col-6 offset-3">
            <div class = "signup-page">
                <h3 style="text-align: center; text-decoration :overline red">Login</h3>
                <hr>
                <form action="/login" method = "POST" class = "needs-validation" novalidate>
                    <div class = "mb-3">
                        <label for="username" class = "form-label">Username</label>
                        <input name = "username" id = "username" class = "form-control" type="text" required>
                    </div>
                    <div class = "mb-3">
                        <label for="password" class = "form-label">Password</label>
                        <input name = "password" id = "password" class = "form-control" type="password" required>
                    </div>
                    <button class = "btn btn-success login-btn" style="margin-left: 0;">Log in</button>
                </form>
            </div>
        </div>
    </div>
</body>